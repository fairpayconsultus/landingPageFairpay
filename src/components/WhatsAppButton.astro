---
// WhatsAppButton.astro
const whatsappNumber = "51983877377";
const message = "Hola, me interesa conocer más sobre Fairpay";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<div class="fixed bottom-8 right-8 z-50">
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="relative flex items-center gap-3 group"
  >
    <!-- Tooltip -->
    <div
      class="absolute right-16 bg-white text-gray-900 px-4 py-2 rounded-full shadow-xl whitespace-nowrap font-medium pointer-events-none opacity-0 translate-x-5 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 border border-gray-100"
    >
      ¿Necesitas ayuda?
    </div>

    <!-- Button -->
    <div class="relative">
      <!-- Animated rings -->
      <div class="absolute inset-0 bg-green-500 rounded-full animate-pulse-ring"></div>
      <div class="absolute inset-0 bg-green-500 rounded-full animate-pulse-ring-delayed"></div>

      <!-- Main button -->
      <div class="relative w-16 h-16 bg-gradient-to-br from-green-400 to-green-600 rounded-full shadow-2xl flex items-center justify-center hover:shadow-green-500/50 hover:scale-110 transition-all duration-300 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 text-white"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
      </div>
    </div>
  </a>
</div>
