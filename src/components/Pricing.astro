<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cotizarBtns = document.querySelectorAll('.cotizar-btn');

    cotizarBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const planName = btn.getAttribute('data-plan-name');
        const planRange = btn.getAttribute('data-plan-range');
        const planDesc = btn.getAttribute('data-plan-desc');
        const isCustomQuote = btn.getAttribute('data-custom-quote') === 'true';

        let planInfo = '';
        if (isCustomQuote) {
          planInfo = `Estoy interesado en el ${planName} - ${planRange}\n${planDesc}\n\nMe gustaría recibir información sobre las soluciones personalizadas para corporaciones.`;
        } else {
          const modulesData = JSON.parse(btn.getAttribute('data-modules') || '[]');
          const modulesList = modulesData.map((m: any) => `- ${m.name}: $${m.price.toLocaleString("en-US", { minimumFractionDigits: 2 })} USD`).join('\n');
          planInfo = `Estoy interesado en el ${planName} - ${planRange}\n${planDesc}\n\nMódulos incluidos:\n${modulesList}`;
        }

        console.log('Setting plan info:', planInfo);
        sessionStorage.setItem('planInfo', planInfo);

        const contactElement = document.getElementById('contacto');
        if (contactElement) {
          contactElement.scrollIntoView({ behavior: 'smooth' });
          setTimeout(() => {
            window.dispatchEvent(new CustomEvent('planInfoUpdated', { detail: planInfo }));
          }, 500);
        }
      });
    });
  });
</script>
