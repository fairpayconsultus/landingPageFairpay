<section id="cambio" class="py-24 bg-gradient-to-br from-blue-50 via-white to-cyan-50/40 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 bg-gradient-to-b from-blue-100/40 to-transparent pointer-events-none"></div>
  
  <!-- Floating decorative elements -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-32 right-12 w-16 h-16 rounded-2xl bg-gradient-to-br from-[#10182b]/15 to-[#a8d9fa]/20 backdrop-blur-sm border border-[#a8d9fa]/50 animate-float-decor-simple-1"></div>
    <div class="absolute bottom-20 left-16 w-20 h-20 rounded-full bg-gradient-to-br from-[#a8d9fa]/20 to-[#405687]/15 backdrop-blur-sm border border-[#405687]/50 animate-float-decor-simple-2"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-32 h-32 rounded-3xl bg-gradient-to-br from-[#405687]/10 to-[#10182b]/10 backdrop-blur-sm border border-blue-300/30 animate-float-decor-simple-3"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal-on-scroll">
      <span class="inline-block px-4 py-2 bg-gradient-to-r from-[#10182b]/10 to-[#405687]/10 text-[#10182b] rounded-full font-semibold mb-4">
        El Problema y La Solución
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
        Modelo Tradicional vs <span class="bg-gradient-to-r from-[#10182b] to-[#405687] bg-clip-text text-transparent">FAIRPAY</span>
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        FAIRPAY transforma la gestión salarial de diagnósticos ocasionales a inteligencia salarial continua.
      </p>
    </div>

    <!-- Comparison Grid -->
    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      <!-- Before - Antes -->
      <div class="relative reveal-on-scroll reveal-left" style="transition-delay: 0.1s">
        <div class="bg-gradient-to-br from-red-50 to-orange-50 rounded-3xl p-8 border border-red-100 shadow-lg">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-red-500"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900">Modelo Tradicional</h3>
          </div>
          <div class="space-y-4">
            {[
              "Estudios salariales esporádicos",
              "Consultoría puntual",
              "Información fragmentada",
              "Decisiones intuitivas",
              "Alto costo por proyecto",
              "Dependencia externa",
            ].map((text) => (
              <div class="flex items-start gap-3 p-4 bg-white/50 backdrop-blur-sm rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                <span class="text-gray-700">{text}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- After - Después con Fairpay -->
      <div class="relative reveal-on-scroll reveal-right" style="transition-delay: 0.1s">
        <div class="bg-gradient-to-br from-purple-50 via-blue-50 to-orange-50 rounded-3xl p-8 border border-purple-200 shadow-xl">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 bg-gradient-to-br from-[#10182b] to-[#405687] rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-gray-900">Después</h3>
              <p class="text-sm text-[#10182b] font-semibold">con Fairpay</p>
            </div>
          </div>
          <div class="space-y-4">
            {[
              { text: "Inteligencia salarial permanente", icon: "check" },
              { text: "Plataforma de gestión continua", icon: "trending-up" },
              { text: "Datos integrados y analítica salarial", icon: "target" },
              { text: "Decisiones basadas en evidencia", icon: "users" },
              { text: "Modelo escalable", icon: "zap" },
              { text: "Autonomía organizacional", icon: "check" },
            ].map((item) => (
              <div class="flex items-start gap-3 p-4 bg-white/70 backdrop-blur-sm rounded-xl hover:shadow-md transition-shadow">
                {item.icon === "check" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"><path d="M20 6 9 17l-5-5"/></svg>
                )}
                {item.icon === "trending-up" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                )}
                {item.icon === "target" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                )}
                {item.icon === "users" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                )}
                {item.icon === "zap" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                )}
                <span class="text-gray-700 font-medium">{item.text}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Decorative badge -->
        <div class="absolute -top-4 -right-4 bg-[#10182b] text-white px-4 py-2 rounded-full font-bold shadow-lg animate-badge-rotate">
          Potenciado por IA
        </div>
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-16 reveal-on-scroll">
      <p class="text-lg text-gray-600 mb-6">
        Únete a las empresas que ya están transformando su gestión de talento
      </p>
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 px-8 py-4 bg-[#a8d9fa] text-[#10182b] rounded-full font-semibold hover:bg-[#7bc3f2] hover:shadow-xl transition-all duration-300 hover:scale-105"
      >
        Comenzar ahora
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes badgeRotate {
    0% {
      transform: scale(0.9) rotate(-5deg);
    }
    50% {
      transform: scale(1.05) rotate(5deg);
    }
    100% {
      transform: scale(0.9) rotate(-5deg);
    }
  }

  .animate-badge-rotate {
    animation: badgeRotate 4s infinite ease-in-out;
  }
</style>
