<section id="contacto" class="py-24 bg-gradient-to-b from-white via-gray-50 to-white relative overflow-hidden">
  <!-- Background Decoration -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-[#10182b]/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-[#a8d9fa]/5 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#405687]/3 rounded-full blur-3xl"></div>
  </div>

  <!-- Floating decorative elements -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-20 left-10 w-20 h-20 rounded-2xl bg-gradient-to-br from-[#10182b]/10 to-[#a8d9fa]/10 backdrop-blur-sm border border-[#10182b]/20 animate-float-decor-simple-1"></div>
    <div class="absolute top-40 right-20 w-16 h-16 rounded-full bg-gradient-to-br from-[#a8d9fa]/10 to-[#405687]/10 backdrop-blur-sm border border-[#a8d9fa]/20 animate-float-decor-simple-2"></div>
    <div class="absolute bottom-32 left-1/4 w-12 h-12 rounded-xl bg-gradient-to-br from-[#405687]/10 to-[#10182b]/10 backdrop-blur-sm border border-[#405687]/20 animate-float-decor-simple-3"></div>
    <div class="absolute bottom-20 right-1/3 w-24 h-24 rounded-3xl bg-gradient-to-br from-[#10182b]/5 to-[#a8d9fa]/5 backdrop-blur-sm border border-blue-200/30 animate-float-pricing-3"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal-on-scroll">
      <span class="inline-block px-4 py-2 bg-gradient-to-r from-[#10182b]/10 to-[#a8d9fa]/10 text-[#10182b] rounded-full font-semibold mb-4">
        Contáctanos
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
        Transforma tu <span class="bg-gradient-to-r from-[#10182b] via-[#405687] to-[#a8d9fa] bg-clip-text text-transparent">gestión salarial</span>
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Agenda una demostración personalizada y descubre cómo Fairpay puede revolucionar tu organización
      </p>
    </div>

    <!-- Content Grid -->
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <!-- Contact Info -->
      <div class="space-y-8 reveal-on-scroll reveal-left">
        <div class="bg-white/70 backdrop-blur-xl rounded-3xl p-8 border border-gray-200/50 shadow-lg">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">
            ¿Por qué elegir Fairpay?
          </h3>
          <ul class="space-y-4">
            {[
              "Automatización completa de procesos salariales",
              "Análisis de equidad con inteligencia artificial",
              "Cumplimiento normativo garantizado",
              "ROI positivo desde el primer mes",
              "Soporte técnico especializado 24/7",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-gradient-to-r from-[#10182b] to-[#a8d9fa] flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contact Details -->
        <div class="space-y-4">
          <div class="flex items-center gap-4 p-4 bg-white/70 backdrop-blur-xl rounded-2xl border border-gray-200/50 shadow-lg">
            <div class="w-12 h-12 bg-gradient-to-br from-[#10182b] to-[#405687] rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <p class="text-sm text-gray-600 font-medium">Email</p>
              <a href="mailto:contacto@consultus.pe" class="text-gray-900 font-semibold hover:text-[#10182b] transition-colors">
                contacto@consultus.pe
              </a>
            </div>
          </div>

          <div class="flex items-center gap-4 p-4 bg-white/70 backdrop-blur-xl rounded-2xl border border-gray-200/50 shadow-lg">
            <div class="w-12 h-12 bg-gradient-to-br from-[#a8d9fa] to-[#10182b] rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h2"/><path d="M18 18h2a2 2 0 0 0 2-2v-5a2 2 0 0 0-2-2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
            </div>
            <div>
              <p class="text-sm text-gray-600 font-medium">Oficinas</p>
              <p class="text-gray-900 font-semibold">San Isidro · Miraflores</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form Card -->
      <div class="reveal-on-scroll reveal-right">
        <div class="bg-white/70 backdrop-blur-xl rounded-3xl p-8 border border-gray-200/50 shadow-xl relative min-h-[500px]">
          <!-- Form Section -->
          <form id="contact-form" class="space-y-6">
            <!-- Name -->
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
                Nombre completo
              </label>
              <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full pl-12 pr-4 py-3 bg-white border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#10182b] focus:border-transparent transition-all"
                  placeholder="Juan Pérez"
                />
              </div>
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
                Email corporativo
              </label>
              <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full pl-12 pr-4 py-3 bg-white border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#10182b] focus:border-transparent transition-all"
                  placeholder="juan.perez@empresa.com"
                />
              </div>
            </div>

            <!-- Company & Phone -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="company" class="block text-sm font-semibold text-gray-700 mb-2">
                  Empresa
                </label>
                <div class="relative">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h2"/><path d="M18 18h2a2 2 0 0 0 2-2v-5a2 2 0 0 0-2-2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    required
                    class="w-full pl-12 pr-4 py-3 bg-white border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#10182b] focus:border-transparent transition-all"
                    placeholder="Mi Empresa"
                  />
                </div>
              </div>

              <div>
                <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">
                  Teléfono
                </label>
                <div class="relative">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    class="w-full pl-12 pr-4 py-3 bg-white border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#10182b] focus:border-transparent transition-all"
                    placeholder="+51 999 999 999"
                  />
                </div>
              </div>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">
                Mensaje
              </label>
              <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-4 w-5 h-5 text-gray-400"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="8"
                  class="w-full pl-12 pr-4 py-3 bg-white border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#10182b] focus:border-transparent transition-all resize-none text-sm"
                  placeholder="Cuéntanos sobre tus necesidades..."
                ></textarea>
              </div>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full flex items-center justify-center gap-3 px-8 py-4 bg-[#a8d9fa] text-[#10182b] rounded-xl font-semibold hover:bg-[#7bc3f2] hover:shadow-xl transition-all duration-300 hover:scale-[1.02] cursor-pointer"
            >
              <span>Enviar mensaje</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><line x1="22" x2="11" y1="2" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </form>

          <!-- Success Screen -->
          <div id="success-screen" class="hidden absolute inset-0 bg-white/90 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center p-8 text-center transition-all duration-500 transform scale-95 opacity-0">
            <div class="w-20 h-20 bg-gradient-to-br from-[#10182b] to-[#a8d9fa] rounded-full flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-white"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
              ¡Mensaje enviado!
            </h3>
            <p class="text-gray-600">
              Nos pondremos en contacto contigo muy pronto.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successScreen = document.getElementById('success-screen');
    const messageField = document.getElementById('message') as HTMLTextAreaElement;

    // Check sessionStorage on load
    const planInfo = sessionStorage.getItem('planInfo');
    if (planInfo) {
      if (messageField) messageField.value = planInfo;
      sessionStorage.removeItem('planInfo');
    }

    // Listen to planInfoUpdated event
    window.addEventListener('planInfoUpdated', (e: any) => {
      if (messageField) {
        messageField.value = e.detail;
      }
    });

    // Handle Form Submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        organization: formData.get('company'),
        phone: formData.get('phone'),
        message: formData.get('message'),
      };

      try {
        const response = await fetch('https://prod-api.fairpay.pe/api/1.0/user/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'TOKENTAP': 'bMwRmtqpH9fg3WnHgZxxFv4yG00YxVe5',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          console.log('Form submitted successfully');
          
          if (successScreen) {
            successScreen.classList.remove('hidden');
            // Force reflow
            void successScreen.offsetWidth;
            successScreen.classList.remove('scale-95', 'opacity-0');
            successScreen.classList.add('scale-100', 'opacity-100');
          }

          form.reset();

          setTimeout(() => {
            if (successScreen) {
              successScreen.classList.remove('scale-100', 'opacity-100');
              successScreen.classList.add('scale-95', 'opacity-0');
              setTimeout(() => {
                successScreen.classList.add('hidden');
              }, 500);
            }
          }, 3000);
        } else {
          console.error('Error submitting form:', response.statusText);
          alert('Hubo un error al enviar el formulario. Por favor, inténtelo de nuevo.');
        }
      } catch (error) {
        console.error('Error submitting form:', error);
        alert('Hubo un error al enviar el formulario. Por favor, inténtelo de nuevo.');
      }
    });
  });
</script>
