---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ValueProposition from '../components/ValueProposition.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import TechModules from '../components/TechModules.astro';
import PlatformGallery from '../components/PlatformGallery.astro';
import Pricing from '../components/Pricing.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout 
  title="Fairpay | Software de Gestión y Arquitectura Salarial" 
  description="Plataforma de inteligencia salarial que automatiza el análisis de puestos, la valoración y el diseño de estructuras salariales justas y competitivas mediante ingeniería salarial e inteligencia artificial."
>
  <div class="min-h-screen bg-white font-[Inter,system-ui,sans-serif] antialiased">
    <Navbar />
    <Hero />
    <ValueProposition />
    <BeforeAfter />
    <TechModules />
    <PlatformGallery />
    <Pricing />
    <ContactForm />
    <Footer />
    <WhatsAppButton />
  </div>
</Layout>
