---
import '../styles/index.css';
import GoogleTagManager from '../components/GoogleTagManager.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Fonts / Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-white font-[Inter,system-ui,sans-serif] antialiased text-gray-900 overflow-x-hidden">
    <GoogleTagManager />
    <slot />

    <script>
      // Intersection Observer for scroll animations
      document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -100px 0px',
          threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        const animateElements = document.querySelectorAll('.reveal-on-scroll');
        animateElements.forEach(el => observer.observe(el));
      });
    </script>

    <style is:global>
      /* Base styles and transition setup for scroll animation */
      .reveal-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform, opacity;
      }

      .reveal-on-scroll.reveal-left {
        transform: translateX(-50px);
      }

      .reveal-on-scroll.reveal-right {
        transform: translateX(50px);
      }

      .reveal-on-scroll.reveal-scale {
        transform: scale(0.95);
      }

      .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translate(0) scale(1);
      }

      /* Float animations keyframes */
      @keyframes float-hero-shape-1 {
        0%, 100% {
          transform: translateY(0) translateX(0) rotate(0deg);
        }
        50% {
          transform: translateY(-30px) translateX(20px) rotate(180deg);
        }
      }

      @keyframes float-hero-shape-2 {
        0%, 100% {
          transform: translateY(0) translateX(0) rotate(0deg);
        }
        50% {
          transform: translateY(40px) translateX(-25px) rotate(-180deg);
        }
      }

      @keyframes float-hero-shape-3 {
        0%, 100% {
          transform: translateY(0) scale(1);
        }
        50% {
          transform: translateY(-20px) scale(1.1);
        }
      }

      @keyframes float-bg-large-1 {
        0%, 100% {
          transform: scale(1) rotate(0deg);
          opacity: 0.3;
        }
        50% {
          transform: scale(1.2) rotate(90deg);
          opacity: 0.5;
        }
      }

      @keyframes float-bg-large-2 {
        0%, 100% {
          transform: scale(1.2) rotate(90deg);
          opacity: 0.3;
        }
        50% {
          transform: scale(1) rotate(0deg);
          opacity: 0.5;
        }
      }

      @keyframes float-decor-simple-1 {
        0%, 100% {
          transform: translateY(0) rotate(0deg);
        }
        50% {
          transform: translateY(-15px) rotate(10deg);
        }
      }

      @keyframes float-decor-simple-2 {
        0%, 100% {
          transform: translateY(0) translateX(0);
        }
        50% {
          transform: translateY(20px) translateX(-10px);
        }
      }

      @keyframes float-decor-simple-3 {
        0%, 100% {
          transform: scale(1) rotate(0deg);
        }
        50% {
          transform: scale(1.1) rotate(-5deg);
        }
      }

      @keyframes float-pricing-1 {
        0%, 100% {
          transform: translateY(0) rotate(0deg);
        }
        50% {
          transform: translateY(-20px) rotate(15deg);
        }
      }

      @keyframes float-pricing-2 {
        0%, 100% {
          transform: translateY(0) translateX(0);
        }
        50% {
          transform: translateY(25px) translateX(15px);
        }
      }

      @keyframes float-pricing-3 {
        0%, 100% {
          transform: translateY(0) rotate(0deg);
        }
        50% {
          transform: translateY(-30px) rotate(-10deg);
        }
      }

      @keyframes pulse-ring {
        0% {
          transform: scale(1);
          opacity: 0.5;
        }
        50% {
          transform: scale(1.4);
          opacity: 0;
        }
        100% {
          transform: scale(1);
          opacity: 0.5;
        }
      }

      @keyframes pulse-ring-delayed {
        0% {
          transform: scale(1);
          opacity: 0.7;
        }
        50% {
          transform: scale(1.2);
          opacity: 0;
        }
        100% {
          transform: scale(1);
          opacity: 0.7;
        }
      }

      /* Classes using animations */
      .animate-float-hero-shape-1 {
        animation: float-hero-shape-1 12s infinite ease-in-out;
      }
      .animate-float-hero-shape-2 {
        animation: float-hero-shape-2 14s infinite ease-in-out;
      }
      .animate-float-hero-shape-3 {
        animation: float-hero-shape-3 8s infinite ease-in-out;
      }
      .animate-float-bg-large-1 {
        animation: float-bg-large-1 20s infinite ease-in-out;
      }
      .animate-float-bg-large-2 {
        animation: float-bg-large-2 15s infinite ease-in-out;
      }
      .animate-float-decor-simple-1 {
        animation: float-decor-simple-1 8s infinite ease-in-out;
      }
      .animate-float-decor-simple-2 {
        animation: float-decor-simple-2 10s infinite ease-in-out;
      }
      .animate-float-decor-simple-3 {
        animation: float-decor-simple-3 6s infinite ease-in-out;
      }
      .animate-float-pricing-1 {
        animation: float-pricing-1 9s infinite ease-in-out;
      }
      .animate-float-pricing-2 {
        animation: float-pricing-2 11s infinite ease-in-out;
      }
      .animate-float-pricing-3 {
        animation: float-pricing-3 10s infinite ease-in-out;
      }
      .animate-pulse-ring {
        animation: pulse-ring 2s infinite ease-in-out;
      }
      .animate-pulse-ring-delayed {
        animation: pulse-ring-delayed 2s infinite ease-in-out;
        animation-delay: 0.5s;
      }
    </style>
  </body>
</html>
